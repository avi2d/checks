{
  "$schema": "./quality.schema.json",
  "defaultBranch": "main",
  "gates": {
    "ci": [
      "bun run build",
      "git diff --exit-code",
      "bun run lint",
      "bun run typecheck",
      "bun run test",
      "./node_modules/.bin/commitlint"
    ],
    "scheduled": ["bun scripts/flake.ts --runs 10 --report flake-report.json"]
  },
  "sources": {
    "production": ["effect-channel/**/*.ts", "scripts/**/*.ts"],
    "effect": { "paths": ["scripts/**/*.ts"], "exempt": ["scripts/feature-rules.ts"] },
    "libraries": [
      {
        "name": "effect",
        "package": "effect",
        "repository": "https://github.com/Effect-TS/effect.git",
        "tag": "effect@{version}",
        "path": "packages/effect/package.json"
      }
    ]
  },
  "size": { "applies": "all" },
  "features": [],
  "agentRules": { "on": [], "off": [] },
  "docs": {
    "pages": { "reference": ["docs/gates/*.md", "docs/configs/*.md"], "explanation": ["docs/design.md"] },
    "forConsumers": ["README.md", "docs/gates/*.md", "docs/configs/*.md"]
  }
}
