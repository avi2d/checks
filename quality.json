{
  "$schema": "./quality.schema.json",
  "defaultBranch": "main",
  "gates": {
    "ci": [
      "bun run build",
      "git diff --exit-code",
      "bun run lint",
      "bun run typecheck",
      "bun run test",
      "./node_modules/.bin/commitlint"
    ],
    "scheduled": ["bun scripts/flake.ts --runs 10 --report flake-report.json"]
  },
  "sources": {
    "production": ["effect-channel/**/*.ts", "scripts/**/*.ts"],
    "effect": { "paths": ["scripts/**/*.ts"], "exempt": ["scripts/feature-rules.ts"] }
  },
  "size": { "fileLines": 400, "functionLines": 100, "applies": "changed" },
  "features": [],
  "agentRules": { "on": [], "off": [] },
  "docs": { "pages": { "explanation": ["docs/design.md"] } }
}
