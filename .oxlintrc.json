{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./oxlintrc.json", "./oxlintrc.quality.json"],
  "plugins": ["typescript", "oxc", "eslint", "import"],
  "ignorePatterns": ["node_modules/**", "dist/**"],
  "rules": {
    "eslint/no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "exit",
        "message": "Return the exit status instead: a bin returns it from the program runMain runs. unicorn/no-process-exit passes over a file with a shebang, so this rule stands in for it there."
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/comment-matchers.ts"],
      "rules": {
        "effect-channel/no-throw": "off"
      }
    }
  ]
}
