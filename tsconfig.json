{
  "extends": ["./tsconfig.effect.json"],
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["src/**/*.ts", "scripts/**/*.ts"],
            "exclude": ["src/quality/effect-channel/**", "src/complexity/readability/**"],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "error",
                "asyncFunction": "error",
                "newPromise": "error",
                "extendsNativeError": "error"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
