{
  "extends": [
    "./tsconfig.effect.json"
  ],
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": [
              "src/**/*.ts",
              "scripts/**/*.ts"
            ],
            "exclude": [
              "src/quality/effect-channel/**",
              "src/complexity/readability/**",
              "src/quality/data-shape/**",
              "src/quality/presets/oxlint.ts",
              "src/quality/presets/knip.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "error",
                "asyncFunction": "error",
                "newPromise": "error",
                "extendsNativeError": "error",
                "processEnv": "error",
                "processEnvInEffect": "error"
              }
            }
          }
        ]
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "oxlint.config.ts",
    "knip.config.ts",
    "dependency-cruiser.config.ts"
  ]
}
