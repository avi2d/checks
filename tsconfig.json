{
  "extends": ["./tsconfig.effect.json"],
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "missingEffectError": "error",
          "unknownInEffectCatch": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "catchUnfailableEffect": "error",
          "catchAllToMapError": "off",
          "missingReturnYieldStar": "error",
          "floatingEffect": "error",
          "outdatedApi": "error",
          "catchToIgnore": "off",
          "catchToOrElseSucceed": "off"
        },
        "overrides": [
          {
            "include": [
              "src/**/*.ts",
              "scripts/**/*.ts"
            ],
            "exclude": [
              "src/quality/effect-channel/**/*",
              "src/complexity/readability/**/*",
              "src/quality/data-shape/**/*",
              "src/testing/bun-test/**/*",
              "src/quality/presets/oxlint.ts",
              "src/quality/presets/knip.ts",
              "src/quality/presets/dependency-cruiser.ts",
              "src/quality/presets/stylelint.ts",
              "src/testing/flake-preload.ts",
              "src/testing/local-test-preload.ts",
              "src/testing/mutation-guard-plugin.ts",
              "src/core/native-launch.ts",
              "node_modules/**/*",
              "dist/**/*.js",
              "**/node_modules/**/*",
              "**/release-assets/**/*",
              "**/reports/**/*",
              "**/repos/**/*"
            ],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "error",
                "extendsNativeError": "error",
                "processEnv": "error",
                "processEnvInEffect": "error",
                "asyncFunction": "error",
                "newPromise": "error"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "dist/bin/**/*.ts", "tests/**/*.ts", "oxlint.config.ts", "knip.config.ts", "dependency-cruiser.config.ts", "commitlint.config.ts", "checks.config.ts"]
}
