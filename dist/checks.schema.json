{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repositoryVisibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "description": "The GitHub repository visibility that selects generated workflow runners.",
      "default": "public"
    },
    "releaseAssets": {
      "type": "boolean",
      "description": "Whether the generated main.yml, or the kit's release.yml, builds the files bun run release:assets writes on Linux and macOS and attaches them to each GitHub release.",
      "default": false
    },
    "platformPackages": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "string",
          "description": "The name release:assets gives each compiled file, which it writes as <binary>-<os>-<cpu>."
        },
        "platforms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "enum": [
                "darwin-arm64",
                "darwin-x64",
                "linux-arm64",
                "linux-x64"
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "darwin-arm64",
              "darwin-x64",
              "linux-arm64",
              "linux-x64"
            ]
          }
        }
      },
      "required": [
        "binary",
        "platforms"
      ],
      "additionalProperties": false,
      "description": "The compiled binary the generated main.yml builds on each named platform and publishes as one npm package per platform before the main package, which lists them as optionalDependencies."
    },
    "extraTestJobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The id of the job in ci.yml, which the checks job requires."
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "The environment variables the job sets for its setup and test commands."
          },
          "setup": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The commands the job runs, one step each, before the test command, such as one that installs a tool."
          },
          "run": {
            "type": "string",
            "description": "The test command."
          }
        },
        "required": [
          "name",
          "run"
        ],
        "additionalProperties": false
      },
      "description": "The test jobs the generated ci.yml runs beside its default ones, each with its own environment, setup commands and test command.",
      "default": []
    },
    "trackerKeyPrefixes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The uppercase tracker prefixes whose numbered keys the comment gate refuses.",
      "default": []
    },
    "smoke": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The extra test files to run with the local unit tier."
    },
    "reach": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "The tests to run when a changed path is missing from the import graph."
    },
    "mutationRunner": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The runner labels for mutation jobs in a private repository."
    },
    "selfHostedRunners": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "The other sets of self-hosted runner labels that jobs in a private repository may use."
    },
    "browser": {
      "type": "object",
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "type": "array",
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "locale": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "locale"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "every-page"
                          ]
                        }
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "preset",
                    "locale"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "locale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "locale"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "preset": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "every-page"
                        ]
                      }
                    ]
                  },
                  "locale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "preset",
                  "locale"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "viewports": {
          "type": "array",
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "width": {
                      "type": "integer",
                      "maximum": 9007199254740991,
                      "exclusiveMinimum": 0
                    },
                    "height": {
                      "type": "integer",
                      "maximum": 9007199254740991,
                      "exclusiveMinimum": 0
                    },
                    "touch": {
                      "type": "boolean"
                    },
                    "device": {
                      "type": "string",
                      "enum": [
                        "phone",
                        "tablet",
                        "desktop"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "type": "string",
                      "enum": [
                        "anchor",
                        "full"
                      ]
                    }
                  },
                  "required": [
                    "preset"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "width": {
                    "type": "integer",
                    "maximum": 9007199254740991,
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "integer",
                    "maximum": 9007199254740991,
                    "exclusiveMinimum": 0
                  },
                  "touch": {
                    "type": "boolean"
                  },
                  "device": {
                    "type": "string",
                    "enum": [
                      "phone",
                      "tablet",
                      "desktop"
                    ]
                  }
                },
                "required": [
                  "name",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "preset": {
                    "type": "string",
                    "enum": [
                      "anchor",
                      "full"
                    ]
                  }
                },
                "required": [
                  "preset"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "states": {
          "type": "array",
          "prefixItems": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "textPx": {
                      "type": "integer",
                      "maximum": 9007199254740991,
                      "exclusiveMinimum": 0
                    },
                    "reducedMotion": {
                      "type": "string",
                      "enum": [
                        "reduce",
                        "no-preference"
                      ]
                    },
                    "checks": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "enum": [
                            "layout",
                            "keyboard",
                            "motion",
                            "axe",
                            "nesting",
                            "html",
                            "links",
                            "assets",
                            "contrast",
                            "weight",
                            "shift",
                            "look"
                          ]
                        }
                      ],
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "enum": [
                          "layout",
                          "keyboard",
                          "motion",
                          "axe",
                          "nesting",
                          "html",
                          "links",
                          "assets",
                          "contrast",
                          "weight",
                          "shift",
                          "look"
                        ]
                      }
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "enlarged-text"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "preset"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "textPx": {
                    "type": "integer",
                    "maximum": 9007199254740991,
                    "exclusiveMinimum": 0
                  },
                  "reducedMotion": {
                    "type": "string",
                    "enum": [
                      "reduce",
                      "no-preference"
                    ]
                  },
                  "checks": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "enum": [
                          "layout",
                          "keyboard",
                          "motion",
                          "axe",
                          "nesting",
                          "html",
                          "links",
                          "assets",
                          "contrast",
                          "weight",
                          "shift",
                          "look"
                        ]
                      }
                    ],
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "layout",
                        "keyboard",
                        "motion",
                        "axe",
                        "nesting",
                        "html",
                        "links",
                        "assets",
                        "contrast",
                        "weight",
                        "shift",
                        "look"
                      ]
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "preset": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "enlarged-text"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "preset"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "targets": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "routes": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ],
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "focusable": {
                  "type": "boolean"
                },
                "contrast": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "selector"
              ],
              "additionalProperties": false
            }
          ],
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "routes": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ],
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "focusable": {
                "type": "boolean"
              },
              "contrast": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "selector"
            ],
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "enum": [
                "layout",
                "keyboard",
                "motion",
                "axe",
                "nesting",
                "html",
                "links",
                "assets",
                "contrast",
                "weight",
                "shift",
                "look"
              ]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "layout",
              "keyboard",
              "motion",
              "axe",
              "nesting",
              "html",
              "links",
              "assets",
              "contrast",
              "weight",
              "shift",
              "look"
            ]
          }
        },
        "weight": {
          "type": "object",
          "properties": {
            "nonImageBytes": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "scriptBytes": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "imageBytes": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "nonImageBytes",
            "scriptBytes",
            "imageBytes"
          ],
          "additionalProperties": false
        },
        "shift": {
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "max"
          ],
          "additionalProperties": false
        },
        "roles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "hooks": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "site",
        "routes",
        "viewports",
        "states",
        "targets",
        "checks"
      ],
      "additionalProperties": false,
      "description": "The site, routes, and checks for browser tests."
    },
    "browserRoutes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "The repository paths that can affect each browser route."
    },
    "browserBuild": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The command that builds the site for the browser test-only proof."
    },
    "browserTimings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "number",
          "minimum": 0
        }
      },
      "description": "The measured milliseconds of each browser check at each route, which browser shards balance on."
    },
    "copy": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "description": "The input globs for the copy gate."
    },
    "frontendSyntax": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "description": "The input globs for the frontend syntax gate."
    },
    "agentTests": {
      "type": "object",
      "properties": {
        "allowLocal": {
          "type": "boolean",
          "description": "Whether agents may start tests outside CI. This setting does not restrict people or CI.",
          "default": false
        }
      },
      "additionalProperties": false,
      "description": "The settings for test runs started by agents.",
      "default": {
        "allowLocal": false
      }
    },
    "testFileMaxSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120,
      "description": "The time limit in seconds for each test file in CI.",
      "default": 120
    },
    "testTierShards": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "e2e": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "additionalProperties": false,
      "description": "The number of parallel CI jobs for each test tier."
    },
    "testFileTimings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "description": "The recorded seconds per test file, which balance the shards."
    },
    "testFileSkips": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The repository-relative paths of test files to exclude from checks-test.",
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {}
}
