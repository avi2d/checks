{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflows": {
      "type": "object",
      "properties": {
        "repositoryVisibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ],
          "description": "The GitHub repository visibility that selects generated workflow runners.",
          "default": "public"
        },
        "releaseAssets": {
          "type": "boolean",
          "description": "Whether the generated main.yml, or the kit's release.yml, builds the files bun run release:assets writes on Linux and macOS and attaches them to each GitHub release.",
          "default": false
        },
        "platformPackages": {
          "type": "object",
          "properties": {
            "binary": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$",
              "description": "The name release:assets gives each compiled file, which it writes as <binary>-<os>-<cpu>."
            },
            "platforms": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "enum": [
                    "darwin-arm64",
                    "darwin-x64",
                    "linux-arm64",
                    "linux-x64"
                  ]
                }
              ],
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "darwin-arm64",
                  "darwin-x64",
                  "linux-arm64",
                  "linux-x64"
                ]
              },
              "description": "The platforms to build on and publish a package for."
            }
          },
          "required": [
            "binary",
            "platforms"
          ],
          "additionalProperties": false,
          "description": "The compiled binary the generated main.yml builds on each named platform and publishes as one npm package per platform before the main package, which lists them as optionalDependencies."
        },
        "extraTestJobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
                "description": "The id of the job in ci.yml, which the checks job requires."
              },
              "env": {
                "type": "object",
                "patternProperties": {
                  "^[A-Za-z_][A-Za-z0-9_]*$": {
                    "type": "string",
                    "pattern": "^[^\\r\\n]*$"
                  }
                },
                "additionalProperties": false,
                "description": "The environment variables the job sets for its setup and test commands."
              },
              "setup": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
                },
                "description": "The commands the job runs, one step each, before the test command, such as one that installs a tool."
              },
              "run": {
                "type": "string",
                "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$",
                "description": "The test command."
              }
            },
            "required": [
              "name",
              "run"
            ],
            "additionalProperties": false
          },
          "description": "The test jobs the generated ci.yml runs beside its default ones, each with its own environment, setup commands and test command.",
          "default": []
        },
        "mutationRunsOn": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The runner labels for mutation jobs in a private repository."
        },
        "mutationShardCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "description": "The maximum number of shards in the generated mutation refresh, as an integer from 1 to 256.",
          "default": 12
        },
        "selfHostedRunsOn": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "The other sets of self-hosted runner labels that jobs in a private repository may use."
        },
        "testShards": {
          "type": "object",
          "properties": {
            "unit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "e2e": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "additionalProperties": false,
          "description": "The number of parallel CI jobs for each test tier."
        },
        "flakeCron": {
          "type": "string",
          "description": "The UTC cron expression for the generated flake workflow, limited to at most once a day with one minute and one hour.",
          "pattern": "^[0-5]?[0-9][ \\t]+(?:[01]?[0-9]|2[0-3])(?:[ \\t]+[^\\s]+){3}$"
        },
        "setupNix": {
          "type": "boolean",
          "description": "Whether unit, e2e, release suite, flake, and whole-tree test jobs in private code repositories run nix --version before tests. The jobs do not install Nix.",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "properties": {
        "extraLocalFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The extra test files to run with the local unit tier."
        },
        "affected": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "The tests to run when a changed path is missing from the import graph."
        },
        "allowAgentRunsOutsideCI": {
          "type": "boolean",
          "description": "Whether agents may start tests outside CI. This setting does not restrict people or CI.",
          "default": false
        },
        "fileTimeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120,
          "description": "The time limit in seconds for each test file in CI.",
          "default": 120
        },
        "fileTimingsSeconds": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "The recorded seconds per test file, which balance the shards."
        },
        "excludeFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The repository-relative paths of test files to exclude from checks-test.",
          "default": []
        }
      },
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "description": "The input globs for the copy gate."
    },
    "frontendSyntax": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "inputs"
      ],
      "additionalProperties": false,
      "description": "The input globs for the frontend syntax gate."
    },
    "commentGate": {
      "type": "object",
      "properties": {
        "trackerKeyPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*$"
          },
          "description": "The uppercase tracker prefixes whose numbered keys the comment gate refuses.",
          "default": []
        }
      },
      "additionalProperties": false
    },
    "lintCoverage": {
      "type": "object",
      "properties": {
        "allowedNestedOxlintRules": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "The rules each nested oxlint config, named by its repository-relative path, may turn off, down to a lower severity, or to other options than the root oxlint config sets."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {}
}
