{
  "name": "@avi2d/checks",
  "version": "0.1.0",
  "description": "Deterministic checks shared across the captain's TypeScript repos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi2d/checks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bunfig.toml",
    "commitlint.config.js",
    "dependency-cruiser.config.js",
    "scripts/lint-coverage.sh",
    "scripts/test-layout.ts",
    "scripts/commit-identity.ts",
    "oxlintrc.json",
    "tsconfig.effect.json",
    "dist/index.js"
  ],
  "exports": {
    "./bunfig.toml": "./bunfig.toml",
    "./commitlint.config.js": "./commitlint.config.js",
    "./dependency-cruiser.config.js": "./dependency-cruiser.config.js",
    "./scripts/lint-coverage.sh": "./scripts/lint-coverage.sh",
    "./scripts/test-layout.ts": "./scripts/test-layout.ts",
    "./scripts/commit-identity.ts": "./scripts/commit-identity.ts",
    "./oxlintrc.json": "./oxlintrc.json",
    "./tsconfig.effect.json": "./tsconfig.effect.json",
    "./dist/index.js": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build effect-channel/index.ts --outdir dist --target node --format esm",
    "lint": "oxlint --type-aware && ./scripts/lint-coverage.sh && bun scripts/test-layout.ts && bun scripts/commit-identity.ts HEAD && depcruise --config .dependency-cruiser.cjs effect-channel scripts tests commitlint.config.js dependency-cruiser.config.js .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "bun test --randomize"
  },
  "peerDependencies": {
    "@swc/core": "1.16.2",
    "dependency-cruiser": "18.4.0",
    "@effect/tsgo": "0.45.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.83.0",
    "@swc/core": "1.16.2",
    "@types/bun": "^1.3.0",
    "dependency-cruiser": "18.4.0",
    "effect": "4.0.0-rc.115",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3"
  }
}
