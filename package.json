{
  "name": "@avi2dg/checks",
  "version": "0.26.0",
  "description": "Deterministic checks shared across a set of TypeScript repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi2d/checks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "docs/configs/",
    "docs/design.md",
    "docs/gates/",
    "bunfig.toml",
    "commitlint.config.js",
    "dependency-cruiser.config.js",
    "knip-base.json",
    "src/quality/lint-coverage.sh",
    "src/core/main.ts",
    "src/core/git.ts",
    "src/core/gates.ts",
    "src/core/lint.ts",
    "src/delivery/changelog.ts",
    "src/delivery/changelog-write.ts",
    "src/delivery/release-notes.ts",
    "src/delivery/release-report.ts",
    "src/testing/test-layout.ts",
    "src/testing/test.ts",
    "src/testing/test-skips.ts",
    "src/core/swc.ts",
    "src/testing/test-report.ts",
    "src/testing/flake.ts",
    "src/delivery/commit-identity.ts",
    "src/testing/mutation-compare.ts",
    "src/testing/subsumed-tests.ts",
    "src/delivery/ci-wiring.ts",
    "src/delivery/shell-command.ts",
    "src/quality/comment-matchers.ts",
    "src/docs/prose-matchers.ts",
    "src/quality/comments.ts",
    "src/quality/comment-gate.ts",
    "src/complexity/suppressions-ratchet.ts",
    "src/complexity/repetition.ts",
    "src/complexity/unused.ts",
    "src/complexity/exports.ts",
    "src/complexity/knip.ts",
    "src/testing/quarantine-clock.ts",
    "src/docs/docs.ts",
    "src/dependencies/vendor.ts",
    "src/dependencies/vendor-args.ts",
    "src/docs/doc-outline.ts",
    "src/docs/doc-rules.ts",
    "src/docs/doc-references.ts",
    "src/docs/doc-snapshot.ts",
    "src/docs/doc-templates.ts",
    "src/docs/doc-names.ts",
    "dist/templates/",
    "src/quality/presets/effect.oxlint.json",
    "src/quality/presets/effect.language-service.json",
    "oxlintrc.json",
    "stryker.preset.js",
    "tsconfig.effect.json",
    "dist/effect-channel/index.js",
    "dist/readability/index.js"
  ],
  "exports": {
    "./dependency-cruiser.config.js": "./dependency-cruiser.config.js",
    "./knip-base.json": "./knip-base.json",
    "./scripts/test-skips.ts": "./src/testing/test-skips.ts",
    "./scripts/comment-matchers.ts": "./src/quality/comment-matchers.ts",
    "./scripts/prose-matchers.ts": "./src/docs/prose-matchers.ts",
    "./stryker.preset.js": "./stryker.preset.js",
    "./templates/*": "./dist/templates/*",
    "./tsconfig.effect.json": "./tsconfig.effect.json"
  },
  "bin": {
    "checks-lint": "src/core/lint.ts",
    "checks-changelog": "src/delivery/changelog-write.ts",
    "checks-release-notes": "src/delivery/release-notes.ts",
    "checks-release-report": "src/delivery/release-report.ts",
    "checks-lint-coverage": "src/quality/lint-coverage.sh",
    "checks-test-layout": "src/testing/test-layout.ts",
    "checks-test": "src/testing/test.ts",
    "checks-flake": "src/testing/flake.ts",
    "checks-commit-identity": "src/delivery/commit-identity.ts",
    "checks-mutation-compare": "src/testing/mutation-compare.ts",
    "checks-subsumed-tests": "src/testing/subsumed-tests.ts",
    "checks-ci-wiring": "src/delivery/ci-wiring.ts",
    "checks-comment-gate": "src/quality/comment-gate.ts",
    "checks-suppressions-ratchet": "src/complexity/suppressions-ratchet.ts",
    "checks-repetition": "src/complexity/repetition.ts",
    "checks-unused": "src/complexity/unused.ts",
    "checks-exports": "src/complexity/exports.ts",
    "checks-quarantine-clock": "src/testing/quarantine-clock.ts",
    "checks-docs": "src/docs/docs.ts",
    "checks-vendor": "src/dependencies/vendor.ts"
  },
  "scripts": {
    "prepare": "bun src/dependencies/vendor.ts --library effect --package effect --repository https://github.com/Effect-TS/effect.git --tag 'effect@{version}' --path packages/effect/package.json",
    "build": "bun build src/quality/effect-channel/index.ts --outdir dist/effect-channel --target node --format esm && bun build src/complexity/readability/index.ts --outdir dist/readability --target node --format esm && bun scripts/doc-templates-write.ts && bun src/delivery/changelog-write.ts && bun scripts/doc-blocks-write.ts",
    "lint": "oxlint --type-aware && bun src/core/lint.ts && depcruise --config .dependency-cruiser.cjs .",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "bun src/testing/test.ts"
  },
  "peerDependencies": {
    "@swc/core": "1.16.2",
    "dependency-cruiser": "18.4.0",
    "@effect/tsgo": "0.45.0",
    "effect": "4.0.0-rc.115",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.83.0",
    "@swc/core": "1.16.2",
    "@types/bun": "^1.3.0",
    "dependency-cruiser": "18.4.0",
    "effect": "4.0.0-rc.115",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "knip": "6.38.0"
  }
}
