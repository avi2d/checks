    "checks-repetition": "scripts/repetition.ts",
    "checks-quarantine-clock": "scripts/quarantine-clock.ts",
    "checks-docs": "scripts/docs.ts",
    "checks-vendor": "scripts/vendor.ts"
  },
  "scripts": {
    "prepare": "bun scripts/vendor.ts --library effect --package effect --repository https://github.com/Effect-TS/effect.git --tag 'effect@{version}' --path packages/effect/package.json",
    "build": "bun build effect-channel/index.ts --outdir dist/effect-channel --target node --format esm && bun build readability/index.ts --outdir dist/readability --target node --format esm && bun scripts/doc-templates-write.ts && bun scripts/changelog-write.ts && bun scripts/doc-blocks-write.ts",
    "lint": "oxlint --type-aware && bun scripts/lint.ts && depcruise --config .dependency-cruiser.cjs .",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "bun scripts/test.ts"
  },
  "peerDependencies": {
    "@swc/core": "1.16.2",
    "dependency-cruiser": "18.4.0",
    "@effect/tsgo": "0.45.0",
    "effect": "4.0.0-rc.115",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002"
  },
