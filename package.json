{
  "name": "@avi2dg/checks",
  "version": "0.35.1",
  "description": "Deterministic checks shared across a set of TypeScript repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi2d/checks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "docs/configs/",
