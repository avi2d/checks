{
  "name": "@avi2dg/checks",
  "version": "0.92.0",
  "description": "Deterministic checks shared across a set of TypeScript repositories",
  "author": {
    "name": "avi2d",
    "email": "avi2dg@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi2d/checks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "docs/",
    "!docs/adr/",
    "bunfig.toml",
    ".bun-version",
    "commitlint.config.ts",
    "dependency-cruiser.config.js",
    "knip-base.json",
    "src/",
    "!src/complexity/readability/",
    "!src/quality/data-shape/",
    "!src/quality/effect-channel/",
    "!src/quality/presets/knip.ts",
    "!src/quality/presets/postcss-value-parser.d.ts",
    "!src/testing/mutation-guard-plugin.ts",
    "!src/testing/unit-test-order.ts",
    "dist/",
    "oxlintrc.json",
    "stryker.preset.js",
    "tsconfig.effect.json",
    "ts-reset.d.ts"
  ],
  "exports": {
    "./dependency-cruiser.config.js": "./dependency-cruiser.config.js",
    "./knip-base.json": "./knip-base.json",
    "./scripts/test-skips.ts": "./src/testing/test-skips.ts",
    "./scripts/comment-matchers.ts": "./src/quality/comment-matchers.ts",
    "./scripts/prose-matchers.ts": "./src/docs/prose-matchers.ts",
    "./stryker.preset.js": "./stryker.preset.js",
    "./templates/*": "./dist/templates/*",
    "./tsconfig.effect.json": "./tsconfig.effect.json",
    "./browser-hooks.ts": "./src/quality/browser/hooks.ts",
    "./browser-checks.json": "./src/quality/browser/browser-checks.json",
    "./screen-sizes.ts": "./src/quality/browser/screen-sizes.ts",
    "./block-screens.ts": "./src/testing/block-screens.ts",
    "./site-test.ts": "./src/testing/site-test.ts",
    "./core/git.ts": "./src/core/git.ts",
    "./core/main.ts": "./src/core/main.ts",
    "./delivery/gitleaks.ts": "./src/delivery/gitleaks.ts",
    "./delivery/gitleaks.toml": "./src/delivery/gitleaks.toml",
    "./dependencies/cache-root.ts": "./src/dependencies/cache-root.ts",
    "./testing/test-report.ts": "./src/testing/test-report.ts",
    "./testing/test.ts": "./src/testing/test.ts",
    "./oxlint": {
      "types": "./dist/presets/oxlint.d.ts",
      "default": "./dist/presets/oxlint.js"
    },
    "./knip": {
      "types": "./dist/presets/knip.d.ts",
      "default": "./dist/presets/knip.js"
    },
    "./dependency-cruiser": {
      "types": "./dist/presets/dependency-cruiser.d.ts",
      "default": "./dist/presets/dependency-cruiser.js"
    },
    "./stylelint": {
      "types": "./dist/presets/stylelint.d.ts",
      "default": "./dist/presets/stylelint.js"
    }
  },
  "bin": {
    "checks-lint": "src/core/lint.ts",
    "checks-changelog": "src/delivery/changelog-write.ts",
    "checks-release-notes": "src/delivery/release-notes.ts",
    "checks-release-report": "src/delivery/release-report.ts",
    "checks-release-pr": "src/delivery/release-pr.ts",
    "checks-release-preflight": "src/delivery/release-preflight.ts",
    "checks-release-publish": "src/delivery/release-publish.ts",
    "checks-release-tag": "src/delivery/release-tag.ts",
    "checks-lint-coverage": "src/quality/lint-coverage.sh",
    "checks-test-layout": "src/testing/test-layout.ts",
    "checks-test": "src/testing/test.ts",
    "checks-flake": "src/testing/flake.ts",
    "checks-commit-identity": "src/delivery/commit-identity.ts",
    "checks-commit-title": "src/delivery/commit-title.ts",
    "checks-docs-only": "src/delivery/docs-only.ts",
    "checks-mutation": "src/testing/mutation.ts",
    "checks-mutation-compare": "src/testing/mutation-compare.ts",
    "checks-mutation-baseline": "src/testing/mutation-baseline.ts",
    "checks-mutation-scope": "src/testing/mutation-scope.ts",
    "checks-mutation-merge": "src/testing/mutation-merge.ts",
    "checks-subsumed-tests": "src/testing/subsumed-tests.ts",
    "checks-whole-tree-run": "src/testing/whole-tree-run.ts",
    "checks-ci-wiring": "src/delivery/ci-wiring.ts",
    "checks-plain-steps": "src/delivery/plain-steps.ts",
    "checks-comment-gate": "src/quality/comment-gate.ts",
    "checks-css-size": "src/quality/css-size.ts",
    "checks-suppressions-ratchet": "src/complexity/suppressions-ratchet.ts",
    "checks-repetition": "src/complexity/repetition.ts",
    "checks-graphwalk": "src/complexity/graphwalk.ts",
    "checks-quarantine-clock": "src/testing/quarantine-clock.ts",
    "checks-docs": "src/docs/docs.ts",
    "checks-adr-index": "src/docs/adr-index.ts",
    "checks-copy": "src/docs/copy.ts",
    "checks-vendor": "src/dependencies/vendor.ts",
    "checks-advisories": "src/dependencies/advisories.ts",
    "checks-secrets": "src/delivery/secrets.ts",
    "checks-no-mistakes-test": "src/delivery/no-mistakes-test.ts",
    "checks-pr-text": "src/delivery/pr-text.ts",
    "checks-setup": "src/delivery/setup.ts",
    "checks-frontend-syntax": "src/quality/frontend-syntax.ts",
    "checks-no-plain-js": "src/quality/no-plain-js.ts",
    "checks-browser": "src/quality/browser/browser.ts",
    "checks-effect-scope": "src/quality/effect-scope.ts"
  },
  "scripts": {
    "prepare": "bun src/dependencies/vendor.ts --library effect --package effect --repository https://github.com/Effect-TS/effect.git --tag 'effect@{version}' --path packages/effect/package.json",
    "desk": "bun run test:fast && bun src/core/lint.ts --desk",
    "build": "bun build src/quality/effect-channel/index.ts --outdir dist/effect-channel --target node --format esm && bun build src/complexity/readability/index.ts --outdir dist/readability --target node --format esm && bun build src/quality/data-shape/index.ts --outdir dist/data-shape --target node --format esm && bun build src/testing/mutation-guard-plugin.ts src/testing/mutation-refusal.ts src/testing/unit-test-order.ts --outdir dist/mutation --target node --format esm --packages external && bun build src/quality/presets/oxlint.ts src/quality/presets/knip.ts src/quality/presets/dependency-cruiser.ts src/quality/presets/stylelint.ts --outdir dist/presets --target node --format esm --packages external && tsc -p tsconfig.presets.json && bun scripts/configs-write.ts && bun src/quality/effect-scope.ts && bun scripts/doc-templates-write.ts && bun src/delivery/changelog-write.ts && bun scripts/doc-blocks-write.ts",
    "lint": "oxlint && bun src/core/lint.ts",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "test": "bun src/testing/test.ts",
    "test:fast": "bun src/testing/test.ts --changed",
    "test:unit": "bun src/testing/test.ts --tier=unit",
    "test:e2e": "bun src/testing/test.ts --tier=e2e",
    "test:live": "bun src/testing/test.ts --tier=live"
  },
  "peerDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@effect/tsgo": "0.45.0",
    "@swc/core": "1.16.2",
    "dependency-cruiser": "18.4.0",
    "effect": "4.0.0",
    "html-validate": "11.16.0",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright-core": "1.63.0",
    "postcss-html": "2.0.0",
    "postcss-value-parser": "4.2.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-plugin-use-baseline": "1.4.7",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "html-validate": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "postcss-html": {
      "optional": true
    },
    "postcss-value-parser": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "stylelint-config-standard": {
      "optional": true
    },
    "stylelint-plugin-use-baseline": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@effect/tsgo": "0.45.0",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@oxlint/plugins": "1.83.0",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.2",
    "@types/bun": "^1.3.0",
    "@types/commonmark": "0.27.10",
    "dependency-cruiser": "18.4.0",
    "effect": "4.0.0",
    "html-validate": "11.16.0",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright-core": "1.63.0",
    "postcss-html": "2.0.0",
    "postcss-value-parser": "4.2.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-plugin-use-baseline": "1.4.7",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "@total-typescript/ts-reset": "0.6.1",
    "commonmark": "0.31.2",
    "knip": "6.38.0",
    "minimatch": "11.0.3"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "qs": "6.16.1",
    "smol-toml": "1.9.0"
  },
  "patchedDependencies": {
    "@hughescr/stryker-bun-runner@1.4.0": "patches/@hughescr%2Fstryker-bun-runner@1.4.0.patch"
  }
}
